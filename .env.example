# Postgres connection string (Neon, Supabase, Vercel Postgres...).
# Leave unset for local dev: an embedded PGlite database is created in ~/.jobpilot/pglite
DATABASE_URL=

# Random 32+ character string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# AI features (fit analysis on job pages, long-answer drafting in the extension).
# Set ONE of these; the first one present is used. LLM_PROVIDER picks one when several are set.
OPENAI_API_KEY=        # platform.openai.com/api-keys            default model gpt-4.1-mini
NVIDIA_API_KEY=        # build.nvidia.com (free credits), nvapi-…  default model nvidia/nemotron-3-super-120b-a12b
ANTHROPIC_API_KEY=     # console.anthropic.com                   default model claude-opus-5-5
# LLM_PROVIDER=openai  # openai | nvidia | anthropic
# LLM_MODEL=           # override the model for the active provider
# OPENAI_BASE_URL=     # point OPENAI_API_KEY at any OpenAI-compatible host (Groq, OpenRouter, local)

# Max AI calls per user per day (protects your API bill on a shared deploy)
AI_DAILY_LIMIT=20

# Vercel Cron sends this as a Bearer token to /api/cron/fetch
CRON_SECRET=
