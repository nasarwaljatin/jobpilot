# Postgres connection string (Neon, Supabase, Vercel Postgres...).
# Leave unset for local dev: an embedded PGlite database is created in ~/.jobpilot/pglite
DATABASE_URL=

# Random 32+ character string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Enables the AI application kit (fit analysis, tailored bullets, cover letter).
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=

# Max AI analyses per user per day (protects your API bill on a shared deploy)
AI_DAILY_LIMIT=20

# Vercel Cron sends this as a Bearer token to /api/cron/fetch
CRON_SECRET=
